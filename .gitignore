.DS_Store
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.ipynb_checkpoints/
*.log
.env
.env.*
!.env.example

# Raw, derived, and model artifacts are versioned outside normal Git.
data/raw/*
!data/raw/manifest.sha256
data/interim/*
data/processed/*
models/*
reports/figures/*
reports/metrics/*
!reports/metrics/phase_01_raw_data_audit.json
!reports/metrics/phase_02_game_state_features.json
!reports/metrics/phase_03_historical_features.json
!reports/metrics/phase_04_model_performance.json
!reports/metrics/phase_04_rf_tuning.json
!reports/metrics/phase_05_nwc_attribution.json
reports/model_cards/*

# Keep final deliverables, not local rendering/inspection artefacts.
outputs/**/*.inspect.ndjson
outputs/**/slide-*.png

# Local notebook and editor state.
.jupyter/
.vscode/settings.local.json
/AGENTS.md
