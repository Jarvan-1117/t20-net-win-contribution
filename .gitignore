.DS_Store
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.ipynb_checkpoints/
*.log
.env
.env.*
!.env.example

# Raw, derived, and model artifacts are versioned outside normal Git.
data/raw/*
!data/raw/README.md
!data/raw/manifest.sha256
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep
models/*
!models/README.md
reports/figures/*
!reports/figures/.gitkeep
reports/metrics/*
!reports/metrics/.gitkeep
!reports/metrics/phase_01_raw_data_audit.json

# Local notebook and editor state.
.jupyter/
.vscode/settings.local.json
